<Window x:Class="DnD_calc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DnD_calc"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="{Binding ElementName=MainFrame, Path=Content.Title}" Height="680" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Button x:Name="CharButton" Grid.Column="0" Content="Характеристики"
                Click="CharButton_Click"></Button>
        <Button x:Name="PersonaButton" Grid.Column="1" Content="Персонажи"
                Click="PersonaButton_Click"></Button>
        <Button x:Name="EnemyButton" Grid.Column="2" Content="Враги"
                Click="EnemyButton_Click"></Button>
        <Button x:Name="LATER" Grid.Column="3" Content="Скоро"
                Click="LATER_Click"></Button>
        
        <Frame x:Name="MainFrame" Grid.Row="1" Grid.ColumnSpan="4" 
               NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
